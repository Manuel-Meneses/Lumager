      "html": "<span class=\"ds-tag\" style=\"--t:#ff8900;--s:#ffe9cf;--i:#8a4200\">Obras</span> <span class=\"ds-tag\" style=\"--t:#34a046;--s:#dcefd6;--i:#1f6a2a\">Clientes</span> <span class=\"ds-tag\" style=\"--t:#1f9a96;--s:#d3eeec;--i:#145f5c\">Prensa</span> <span class=\"ds-tag\" style=\"--t:#e0a332;--s:#f6e6c4;--i:#6e4a0e\">Diario de obra</span> <span class=\"ds-tag\" style=\"--t:#5a67b0;--s:#e1e4f4;--i:#353f7a\">Empresa</span>",
