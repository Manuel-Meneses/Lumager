    {
      "name": "Portada de video",
      "kind": "custom",
      "refersTo": "video-play",
      "description": "Portada local con play cuadrado naranja y duración tabular; YouTube carga al tocar.",
      "html": "<button class=\"ds-video\"><span class=\"ds-play\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M240 128a15.74 15.74 0 0 1-7.6 13.51L88.32 229.65a16 16 0 0 1-16.2.3A15.86 15.86 0 0 1 64 216.13V39.87a15.86 15.86 0 0 1 8.12-13.82 16 16 0 0 1 16.2.3l144.08 88.14A15.74 15.74 0 0 1 240 128Z\"/></svg></span><span class=\"ds-dur\">0:35</span></button>",
      "css": ".ds-video{position:relative;display:block;width:22rem;aspect-ratio:16/9;border:0;border-radius:0;cursor:pointer;background:linear-gradient(to top,rgb(17 19 18/.55),transparent 38%),linear-gradient(160deg,#cfe3f3,#8fa6b8 55%,#3a3326);font-family: Archivo, system-ui, sans-serif;}.ds-play{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:3.5rem;height:3.5rem;background:#ff8900;color:#1b1d1c;translate:-50% -50%;transition:transform 300ms cubic-bezier(.23,1,.32,1)}.ds-video:hover .ds-play{transform:scale(1.12)}.ds-video:focus-visible{outline:2px solid #ff8900;outline-offset:-4px}.ds-dur{position:absolute;right:.75rem;bottom:.9rem;font-size:.8rem;font-weight:600;color:#f3f4f1;font-variant-numeric:tabular-nums}"
