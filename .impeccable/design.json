      "html": "<nav class=\"ds-module\"><a class=\"ds-cell ds-logo\">Lumager</a><a class=\"ds-cell\" data-on=\"true\"><span class=\"ds-mark\"></span>Clientes</a><a class=\"ds-cell\"><span class=\"ds-mark\"></span>Servicios</a><a class=\"ds-cell\"><span class=\"ds-mark\"></span>Noticias</a><a class=\"ds-cell ds-cta\">Contanos tu proyecto</a></nav>",
      "css": ".ds-module{display:flex;gap:2px;padding:2px;height:4rem;background:rgb(96 102 99/.9);box-shadow:0 12px 34px rgb(10 12 11/.3);font-family: Archivo, system-ui, sans-serif;}.ds-cell{display:flex;align-items:center;gap:.65rem;padding:0 1.25rem;background-color:rgb(27 29 28/.95);background-image:linear-gradient(90deg,transparent calc(25% - .5px),rgb(255 255 255/.05) calc(25% - .5px) calc(25% + .5px),transparent calc(25% + .5px) calc(50% - .5px),rgb(255 255 255/.05) calc(50% - .5px) calc(50% + .5px),transparent calc(50% + .5px) calc(75% - .5px),rgb(255 255 255/.05) calc(75% - .5px) calc(75% + .5px),transparent calc(75% + .5px));color:rgb(243 244 241/.82);font-size:.95rem;white-space:nowrap;text-decoration:none;cursor:pointer;transition:background-color 300ms cubic-bezier(.23,1,.32,1)}.ds-cell:hover{background-color:rgb(48 53 51/.85);color:#f3f4f1}.ds-logo{font-weight:700;color:#f3f4f1;font-variation-settings:\"wdth\" 125}.ds-mark{width:7px;height:7px;background:#ff8900;transform:scale(0);transition:transform 300ms cubic-bezier(.23,1,.32,1)}.ds-cell[data-on=\"true\"]{color:#f3f4f1;background-image:linear-gradient(to top,rgb(255 137 0/.2),transparent 70%)}.ds-cell[data-on=\"true\"] .ds-mark{transform:scale(1)}.ds-cta{background:#ff8900;color:#1b1d1c;font-weight:600}.ds-cta:hover{background:#ff9d2e;color:#1b1d1c}.ds-cell:focus-visible{outline:2px solid #ff8900;outline-offset:-3px}"
